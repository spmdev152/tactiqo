# Django
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_DEBUG=true
DJANGO_LOG_LEVEL=DEBUG
DJANGO_SECRET_KEY=insecure-local-development-key
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SIGN_IN_THROTTLE_RATE=5/m
DJANGO_TRUSTED_PROXY_NETWORKS=172.16.0.0/12

# PostgreSQL
POSTGRES_DB=tactiqo
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=tactiqo
POSTGRES_PORT=5432
POSTGRES_USER=tactiqo

# Redis and Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
REDIS_URL=redis://redis:6379/0

# Sportmonks, server-side only
SPORTMONKS_API_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_LEAGUE_IDS=8,82,301,384,564

# Frontend
BACKEND_API_BASE_URL=http://api:8000/api/v1
SESSION_COOKIE_INSECURE=true
