{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "sportmonks-football": {
      "type": "stdio",
      "command": "bunx",
      "args": ["--bun", "@sportmonks/football-mcp-server@1.5.0"],
      "env": {
        "SPORTMONKS_API_TOKEN": "!sed -n 's/^SPORTMONKS_API_TOKEN=//p' .env.local | head -1"
      }
    }
  }
}
